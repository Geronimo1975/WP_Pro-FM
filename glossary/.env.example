# ProFM24 Glossary Generator Configuration
# Copy to .env and fill in your values

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://profm_user:password@localhost:5433/profm_glossar
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=profm_glossar
POSTGRES_USER=profm_user
POSTGRES_PASSWORD=your_secure_password

# ===========================================
# WORDPRESS
# ===========================================
WP_SITE_URL=https://profm24.de
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ===========================================
# OPENAI
# ===========================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7

# ===========================================
# VPS SERVER
# ===========================================
VPS_HOST=217.154.250.85
VPS_USER=root
VPS_PATH=/var/www/profm24

# ===========================================
# GOOGLE SHEETS (Optional)
# ===========================================
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHARE_EMAIL=

# ===========================================
# RANKMATH (Optional)
# ===========================================
RANKMATH_API_KEY=

# ===========================================
# GENERATION SETTINGS
# ===========================================
GENERATION_DELAY=1.0
GENERATION_RETRIES=3
BATCH_SIZE=50
