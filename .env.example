# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-new-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
POSTGRES_DB=wp_profm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# WordPress API
WP_SITE_URL=https://profm24.de
WP_USERNAME=admin
WP_APP_PASSWORD=your-app-password

# WordPress Database (optional - for direct sync)
WP_DB_NAME=
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_HOST=
WP_DB_PORT=3306

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# IndexNow (SEO)
INDEXNOW_API_KEY=your-indexnow-key

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@profm24.de

# CORS (for frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
